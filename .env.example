# JWT_SECRET: Required in production. Used to sign admin session tokens.
# Generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Supabase (free, no credit card required at supabase.com):
# Project Settings > API in your Supabase dashboard.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Name of the public Supabase Storage bucket used for uploaded images/videos.
# Create this bucket in Supabase (Storage tab) and mark it Public.
SUPABASE_UPLOADS_BUCKET="uploads"

# PORT: only used for traditional/VPS hosting; ignored by Vercel.
PORT="3000"

# NODE_ENV: set to "production" for the deployed build (traditional hosting only).
NODE_ENV="production"
